  { date: "Mayıs 2026",  level: "Kritik", tag: "Tüm portföy",             url: "https://www.koreaherald.com/article/10731852",                                                              title: "Q1 2026: Rekor gelir +36%, Faaliyet Karı +115,5% YoY",                detail: "Q1 2026 konsolide gelir 654 Mn € (₩1,145T · May 2026 kuru 1.750), faaliyet marjı %28,1. 5 yeni ürün geliri 332 Mn € (₩581,2 mrd, +67% YoY) = toplam gelirin %60'ı. Omlyclo AB: Danimarka %98, İspanya %80, Hollanda %70 pay (4 ayda). Yıllık ₩5,3T gelir / ₩1,8T faaliyet kar hedefini aşması bekleniyor." },
  { date: "Nisan 2026",  level: "Kritik", tag: "Herzuma SC / AB",         url: "https://www.pearceip.law/2026/04/30/celltrion-submits-ema-application-for-trastuzumab-sc-biosimilar/", title: "Herzuma SC için EMA başvurusu yapıldı",                          detail: "İlk SC trastuzumab biosimilar adayı. Hyaluronidase platform kullanıyor. EMA süreci başladı." },
